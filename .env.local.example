# ===================================
# TP Extractor - Environment Variables
# ===================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# -----------------------------------
# Anthropic API (Required)
# -----------------------------------
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your_api_key_here

# -----------------------------------
# Convex (Required)
# -----------------------------------
# Get your Convex URL from: https://dashboard.convex.dev/
# Format: https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# -----------------------------------
# Clerk Authentication (Required)
# -----------------------------------
# Get your keys from: https://dashboard.clerk.com/
# Publishable key (safe for frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Secret key (backend only - never expose to client)
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# -----------------------------------
# Optional: Convex Backend
# -----------------------------------
# Only needed if using server-side Convex calls
# CONVEX_URL=https://your-deployment.convex.cloud

# -----------------------------------
# Optional: Clerk JWT Issuer (Convex auth)
# -----------------------------------
# Override the default Clerk domain for Convex auth
# Only needed if using a different Clerk instance
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
